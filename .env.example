# ── Firebase ──────────────────────────────────────────────────────────────────
# URL database (lấy từ Firebase Console → Realtime Database → Rules)
FIREBASE_DB_URL=https://web-shop-2e6ec-default-rtdb.asia-southeast1.firebasedatabase.app

# Service Account JSON (lấy từ Firebase Console → Project Settings → Service accounts → Generate new private key)
# Dán toàn bộ nội dung file JSON vào đây (dạng 1 dòng)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"web-shop-2e6ec","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@web-shop-2e6ec.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token bot (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Chat ID admin (gửi /start cho bot rồi vào https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_ADMIN_CHAT_ID=7078570432

# ── muathengay.vn ─────────────────────────────────────────────────────────────
# Email dùng để đặt hàng trên muathengay.vn (email của bạn)
ORDER_EMAIL=your-email@gmail.com

# ── Tùy chỉnh ─────────────────────────────────────────────────────────────────
# Timeout đơn hàng (giây) — mặc định 1800 = 30 phút
ORDER_TIMEOUT_SECONDS=1800

# Khoảng thời gian poll mã thẻ (giây) — mặc định 30s
POLL_INTERVAL_SECONDS=30

# Khoảng thời gian check Firebase đơn mới (giây) — mặc định 5s
WATCH_INTERVAL_SECONDS=5
